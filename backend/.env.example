APP_ENV=development

# Matches infra/.env's POSTGRES_USER/PASSWORD/DB — see docs/Architecture-Decisions.md §10.
DATABASE_URL=postgresql://candidate_true_companion:CHANGE_ME@localhost:5432/candidate_true_companion

S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# LLM provider — still Anthropic today. The code has NOT migrated to Azure
# OpenAI yet (see docs/Architecture-Decisions.md §4c) — this app won't run
# without ANTHROPIC_API_KEY until that migration lands. Delete this block
# and uncomment the Azure OpenAI one below once backend/app/services/llm.py
# is actually rewritten.
ANTHROPIC_API_KEY=

# Azure OpenAI (planned, 2026-09-03 — see docs/Architecture-Decisions.md §4c).
# Not read by the code yet.
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=
# AZURE_OPENAI_DEPLOYMENT_EXTRACTION=
# AZURE_OPENAI_DEPLOYMENT_INTERVIEW=
# AZURE_OPENAI_DEPLOYMENT_REPORT=

# Self-hosted Helicone gateway URL. Leave empty to call the LLM provider
# directly (local dev without Helicone running). NOTE: the header/base-URL
# pattern for proxying Azure OpenAI through Helicone differs from the
# Anthropic-specific wiring currently in backend/app/services/llm.py.
HELICONE_BASE_URL=
HELICONE_API_KEY=

STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

SESSION_DURATION_MIN=30
