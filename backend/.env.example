APP_ENV=development

# Matches infra/.env's POSTGRES_USER/PASSWORD/DB — see docs/Architecture-Decisions.md §10.
DATABASE_URL=postgresql://candidate_true_companion:CHANGE_ME@localhost:5432/candidate_true_companion

# File storage — Azure Blob Storage (switched from S3, 2026-09-20, see
# docs/Architecture-Decisions.md §4d). Connection-string auth for now; revisit
# managed identity once this runs on the VM (ADR §10).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# LLM provider — Azure OpenAI (migrated 2026-09-20, see
# docs/Architecture-Decisions.md §4c). This app won't run without these set —
# fill in the endpoint/key and whatever deployment names you gave the three
# Azure OpenAI deployments in the Azure portal (Azure identifies models by a
# deployment name you choose, not a published model id).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_EXTRACTION=
AZURE_OPENAI_DEPLOYMENT_INTERVIEW=
AZURE_OPENAI_DEPLOYMENT_REPORT=

# Self-hosted Helicone gateway URL. Leave empty to call Azure OpenAI directly
# (local dev without Helicone running). NOTE: self-hosted Helicone's Azure
# OpenAI integration uses a different base-URL/header pattern than the old
# Anthropic-specific wiring — this has NOT been set up/verified yet (still
# just passed through as base_url same as before); revisit before relying on
# Helicone routing in a real Azure OpenAI deployment.
HELICONE_BASE_URL=
HELICONE_API_KEY=

STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

SESSION_DURATION_MIN=30
