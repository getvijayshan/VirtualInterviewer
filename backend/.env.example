APP_ENV=development

# Auth gate (FL-06). With no SMTP_HOST the OTP is only printed to the API log;
# OTP_ECHO_CODE=true additionally returns it in the response (TEST MODE ONLY).
OTP_ECHO_CODE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# OAuth sign-in. A provider's button shows only when its id+secret are set and
# AUTH_SECRET is non-empty. Register <API_PUBLIC_URL>/auth/oauth/<google|linkedin>/callback
# as the redirect URI with each provider (LinkedIn: "Sign In with LinkedIn using OpenID Connect").
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
API_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000

# Matches infra/.env's POSTGRES_USER/PASSWORD/DB — see docs/Architecture-Decisions.md §10.
DATABASE_URL=postgresql://candidate_true_companion:CHANGE_ME@localhost:5432/candidate_true_companion

# File storage — Azure Blob Storage (switched from S3, 2026-09-20, see
# docs/Architecture-Decisions.md §4d). Connection-string auth for now; revisit
# managed identity once this runs on the VM (ADR §10).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

# LLM provider — Azure OpenAI (migrated 2026-09-20, endpoint corrected to the
# v1 API surface 2026-09-21, see docs/Architecture-Decisions.md §4c). This app
# won't run without these set. AZURE_OPENAI_ENDPOINT is the v1 base URL, e.g.
# https://<resource>.openai.azure.com/openai/v1 (no api_version needed on this
# surface). Deployment names are whatever you named them in the Azure portal
# (Azure identifies models by a deployment name you choose, not a published
# model id) — this app's deployments are all gpt-5-mini, which requires
# max_completion_tokens, not max_tokens (handled in llm.py).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_EXTRACTION=
AZURE_OPENAI_DEPLOYMENT_INTERVIEW=
AZURE_OPENAI_DEPLOYMENT_REPORT=

# Self-hosted Helicone gateway URL. Leave empty to call Azure OpenAI directly
# (local dev without Helicone running). NOTE: self-hosted Helicone's Azure
# OpenAI integration uses a different base-URL/header pattern than the old
# Anthropic-specific wiring — this has NOT been set up/verified yet (still
# just passed through as base_url same as before); revisit before relying on
# Helicone routing in a real Azure OpenAI deployment.
HELICONE_BASE_URL=
HELICONE_API_KEY=

STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=

SESSION_DURATION_MIN=30
